{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [2, "always", [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "chore"
    ]],
    "scope-enum": [1, "always", [
      "model",
      "config",
      "deps",
      "docs",
      "ci",
      "test",
      "benchmark"
    ]]
  }
}
